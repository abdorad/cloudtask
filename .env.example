# Copy this file to .env and replace every CHANGE_ME value before starting Docker Compose.
# These values initialize PostgreSQL only when its data volume is empty. The administrator
# account is not used by the application after initialization.
CLOUDTASK_POSTGRES_USER=cloudtask_admin
CLOUDTASK_POSTGRES_PASSWORD=CHANGE_ME
CLOUDTASK_POSTGRES_DB=cloudtask

# These least-privilege accounts are created automatically during the first PostgreSQL initialization.
# Keep these values for every fresh installation. If an existing legacy .env omits all four values,
# Compose reuses CLOUDTASK_POSTGRES_USER and CLOUDTASK_POSTGRES_PASSWORD so its existing volume,
# table ownership, and credentials continue to work. Use URL-safe passwords because Compose uses
# these same values in PostgreSQL connection URLs.
CLOUDTASK_POSTGRES_MIGRATION_USER=cloudtask_migrate
CLOUDTASK_POSTGRES_MIGRATION_PASSWORD=CHANGE_ME
CLOUDTASK_POSTGRES_APPLICATION_USER=cloudtask_app
CLOUDTASK_POSTGRES_APPLICATION_PASSWORD=CHANGE_ME

CLOUDTASK_RABBITMQ_USER=CHANGE_ME
CLOUDTASK_RABBITMQ_PASSWORD=CHANGE_ME

CLOUDTASK_MINIO_ROOT_USER=CHANGE_ME
CLOUDTASK_MINIO_ROOT_PASSWORD=CHANGE_ME
CLOUDTASK_S3_BUCKET=cloudtask

CLOUDTASK_GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Required to sign in to the dashboard and call task APIs. Generate a unique
# random value of at least 32 characters; do not reuse any password below.
CLOUDTASK_JWT_SECRET=CHANGE_ME
CLOUDTASK_BOOTSTRAP_USER_EMAIL=operator@example.com
CLOUDTASK_BOOTSTRAP_USER_PASSWORD=CHANGE_ME

# Application behavior
CLOUDTASK_UPLOAD_MAX_BYTES=20971520
CLOUDTASK_MAX_ATTEMPTS=3
CLOUDTASK_RETRY_DELAY_SECONDS=10
CLOUDTASK_S3_MAX_ATTEMPTS=3
CLOUDTASK_S3_CONNECT_TIMEOUT_SECONDS=3
CLOUDTASK_S3_READ_TIMEOUT_SECONDS=10
CLOUDTASK_CORS_ORIGINS=http://localhost:3000
CLOUDTASK_JWT_EXPIRY_MINUTES=480
CLOUDTASK_RATE_LIMIT_REQUESTS=120
CLOUDTASK_RATE_LIMIT_UPLOADS=10
CLOUDTASK_RATE_LIMIT_LOGIN_ATTEMPTS=10
CLOUDTASK_RATE_LIMIT_WINDOW_SECONDS=60
CLOUDTASK_OUTBOX_POLL_SECONDS=5
CLOUDTASK_TASK_LEASE_SECONDS=300
